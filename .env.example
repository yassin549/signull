# === TRADING BOT CONFIGURATION ===

# Trading mode: "paper" (simulated) or "live" (real orders)
TRADING_MODE=paper

# Asset to trade: btc, eth, sol, xrp
ASSET=btc

# Active strategy
BOT_STRATEGY=signull_1_5

# === WALLET ===
# EOA private key (required for live trading, optional for paper)
PRIVATE_KEY=0x...

# Predict.fun deposit account address (also known as FUNDER_ADDRESS)
FUNDER_ADDRESS=0x...

# Predict.fun API key (get from https://developers.predict.fun)
# Required for live trading; not needed on testnet
PREDICT_API_KEY=

# Predict.fun API host
# Mainnet: https://api.predict.fun
# Testnet: https://api-testnet.predict.fun
PREDICT_API_HOST=https://api-testnet.predict.fun

# BNB Chain RPC URL for on-chain checks
# BSC Mainnet: https://bsc-dataseed.binance.org
# BSC Testnet: https://data-seed-prebsc-1-s1.binance.org:8545
BNB_RPC_URL=https://bsc-dataseed.binance.org

# Is FUNDER_ADDRESS a Predict Smart Wallet (not an EOA)?
# Set to "true" if using a Predict account (deposit address exported from predict.fun)
IS_PREDICT_ACCOUNT=false

# === PAPER TRADING ===
# Initial capital for paper trading
PAPER_INITIAL_CAPITAL=100

# === ORDER SIZING ===
# Use fixed USDT stake per trade (true) or percentage of bankroll (false)
USE_FIXED_STAKE=true

# Fixed USDT amount per trade
FIXED_STAKE_USDC=1.0

# Maximum entry price for outcome tokens (0.01-0.99)
MAX_ENTRY_PRICE=0.55

# === RISK PARAMETERS ===
# Probability threshold for entry
SIGNULL_THRESHOLD=0.75

# Risk percentage of bankroll per trade (for %-based sizing)
SIGNULL_RISK_PCT=0.10

# BTC delta target for signull_1_5 strategy ($)
SIGNULL_TARGET_DELTA=10.0

# Strategy-specific params
SIGNULL_MIN_RISK_PCT=0.05
SIGNULL_MAX_RISK_PCT=0.50
SIGNULL_TRUST_LOOKBACK=3
SIGNULL_BTC_ALIGN_MIN=0.55
SIGNULL_BIG_EQUITY_BUFFER=1.25

# === ORDER MANAGEMENT ===
# Max times to chase an unfilled order with a better price
MAX_CHASE_ATTEMPTS=5

# Seconds between chase attempts
CHASE_INTERVAL_SEC=5.0

# === POLLING ===
# Bot tick interval (seconds)
BOT_POLL_INTERVAL_SEC=2

# Dashboard push interval (ms)
DASHBOARD_PUSH_MS=250

# === SERVER ===
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# === FEES (Predict.fun) ===
# Predict.fun: makers pay no fee, takers pay 0.018%-2%
MAKER_FEE_RATE=0.0
TAKER_FEE_RATE=0.02

# === WALLET MONITOR ===
WALLET_POLL_MS=1000
WALLET_BALANCE_STALE_SEC=60.0
GAS_WARN_BNB=0.01